# ─── 全局 ───
COMPOSE_PROJECT_NAME=book_library

# ─── 后端 ───
BACKEND_PORT=8000
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
TOKEN_EXPIRES_IN=7d+
# 数据库: sqlite | postgres
DB_DRIVER=sqlite
# sqlite 文件路径（容器内）
SQLITE_PATH=/app/data/book_library.db
# postgres（DB_DRIVER=postgres 时启用）
# DATABASE_URL=postgres://book:book@db:5432/book_library

# ─── 前端 ───
FRONTEND_PORT=3000
# 浏览器端调用的 API 地址（公开）
NEXT_PUBLIC_API_BASE=https://youhxian.cn/api

# ─── Nginx ───
NGINX_PORT=80
NGINX_SSL_PORT=443

# ─── Let's Encrypt ───
ACME_EMAIL=youveritas@163.com
DOMAIN=youhxian.cn
